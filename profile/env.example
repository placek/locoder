# Secrets for the locoder profile. `make install` copies this to
# $HERMES_HOME/.env (mode 600) once and never overwrites it. Never commit the copy.

# The openrouter rung (Claude Code pointed at OpenRouter) and the Hermes
# openrouter provider both use it.
OPENROUTER_API_KEY=

# Optional: higher limits for the web research backends.
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
