[Unit]
Description=locoder: Julia-1 shadow judge (CPU)
Documentation=file://@REPO@/README.md

[Service]
Type=simple
ExecStartPre=-@DOCKER@ rm -f locoder-julia
# Read-only root: the model and runtime are baked into the image (which runs with the
# Hugging Face libraries offline), and it answers only on the published loopback port.
ExecStart=@DOCKER@ run --rm --name locoder-julia \
    --read-only --tmpfs /tmp \
    --publish 127.0.0.1:@JULIA_PORT@:8080 \
    --cpus 2 --memory 2g \
    @IMAGE@
ExecStop=@DOCKER@ stop --time 10 locoder-julia
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
