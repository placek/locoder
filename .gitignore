# Hermes writes runtime state into the linked skills/ directory.
skills/.hub/
skills/.usage.json
skills/.usage.json.lock
skills/.bundled_manifest
skills/.curator_state
skills/.curator_ledger.jsonl
skills/.archive/
skills/.curator_backups/

# Bundled skills Hermes syncs in (skills/.bundled_manifest names them). The repo's
# own skills are hand-authored and tracked; these are machine-synced copies that
# .no-bundled-skills was meant to keep out, so they stay untracked rather than
# showing up as a spurious diff after each sync.
skills/autonomous-ai-agents/

# Python bytecode from the plugins Hermes loads out of plugins/, and from tests.
__pycache__/
*.pyc
.pytest_cache/

# Secrets live in $HERMES_HOME/.env, never here.
.env

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
