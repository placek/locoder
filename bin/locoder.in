#!/usr/bin/env bash
# Generated by `make install` from bin/locoder.in. Edit the template, not this file.
#
# Runs the pinned Hermes against the locoder home. Everything else (TUI, `chat`,
# `plugins list`, `skills list`) is plain hermes, just aimed at this profile.
export HERMES_HOME="@HERMES_HOME@"
export HERMES_DEFUDDLE_BIN="@PREFIX@/tools/defuddle/node_modules/.bin/defuddle"
# escalate() starts child processes (claude, a one-shot locoder run) that read
# keys such as OPENROUTER_API_KEY from their environment, so the profile's .env
# must be in the environment, not only read by Hermes.
if [ -f "$HERMES_HOME/.env" ]; then
    set -a
    # shellcheck disable=SC1091
    . "$HERMES_HOME/.env"
    set +a
fi
exec "@PREFIX@/hermes/.venv/bin/hermes" "$@"
